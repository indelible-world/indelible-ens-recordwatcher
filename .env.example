# Ethereum RPC URL — WebSocket recommended for real-time events, HTTP works with polling
RPC_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the account that will send removeEnsBinding transactions
# Must have ETH for gas. DO NOT commit this file with a real key.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Deployed IndelibleENS contract address
# Defaults to the canonical address from @indelible-world/indelible-protocol
# INDELIBLE_ENS_ADDRESS=0x1111113661d1fbd85b6d131beb199063582c2be7

# ENS Registry — defaults to the canonical address from @indelible-world/indelible-protocol
# ENS_REGISTRY_ADDRESS=0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e

# Comma-separated ENS resolver addresses to watch for TextChanged events.
# If empty, the watcher relies on NewResolver events + periodic polling.
# The ENS Public Resolver on mainnet:
# RESOLVER_ADDRESSES=0x231b0Ee14048e9dCcD1d247744d114a4EB5E8E63

# How often (ms) to poll all bindings as a safety net (default: 300000 = 5 min)
# POLL_INTERVAL_MS=300000

# Chain ID (default: 1 for mainnet)
# CHAIN_ID=1
